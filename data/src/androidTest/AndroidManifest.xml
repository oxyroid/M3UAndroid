<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.m3u.permission.BIND_EXTENSION_HOST"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.m3u.permission.BIND_EXTENSION_HOST" />

    <queries>
        <intent>
            <action android:name="com.m3u.extension.action.BIND_EXTENSION" />
        </intent>
    </queries>

    <application android:usesCleartextTraffic="true">
        <provider
            android:name="com.m3u.data.worker.PersistablePermissionTestProvider"
            android:authorities="com.m3u.data.test.persistable-uri"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
